# Copia este archivo como .env y completa los valores.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=peaje_app
DB_PASSWORD=cambiar
DB_NAME=peaje_iot

# --- API ---
# Mínimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
RECARGA_MAXIMA=100000.00
# Opcional: orígenes web permitidos (separados por coma). Vacío = sin CORS (app nativa).
CORS_ORIGINS=

# --- Token NFC dinámico (HCE) ---
# Mínimo 32 caracteres, distinto de JWT_SECRET.
NFC_TOKEN_SECRET=
NFC_TOKEN_TTL_SEGUNDOS=300

# --- MQTT ---
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_WORKER_USER=peaje_worker
MQTT_WORKER_PASSWORD=
# Un usuario por ESP32: <codigo_garita>:<clave>, separados por coma (sin comas en la clave)
MQTT_DISPOSITIVOS=garita_norte:clave_esp32

# --- Reglas de cobro ---
# Opción 2: cobro por UID (tarjeta física / UID virtual, lector RC522)
PERMITIR_COBRO_UID=true
# Segundos en los que una segunda lectura del mismo usuario en la misma garita no se cobra
ANTI_DOBLE_COBRO_SEGUNDOS=10
