FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY common.py api_peaje.py worker_mqtt.py ./

RUN useradd --system --uid 10001 peaje
USER peaje

# docker-compose define el comando de cada servicio (api / worker); éste es el predeterminado
CMD ["uvicorn", "api_peaje:app", "--host", "0.0.0.0", "--port", "8000"]
